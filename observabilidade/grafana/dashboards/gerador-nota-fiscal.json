{
  "uid": "gerador-nota-fiscal",
  "title": "Gerador de nota fiscal",
  "tags": [
    "gerador-nota-fiscal"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições por status",
      "description": "Requisições por segundo ao endpoint da nota, por status HTTP.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Erros 5xx",
      "description": "Parcela de requisições válidas com 5xx (4xx não contam, RFC 6.4).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum(rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\",status!~\"4..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência p95 e p99",
      "description": "SLO: p95 < 800 ms e p99 < 1,5 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_milliseconds_bucket{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_milliseconds_bucket{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Notas emitidas",
      "description": "Notas emitidas por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(notas_emitidas_total{service_name=\"gerador-nota-fiscal\"}[$__rate_interval]))",
          "legendFormat": "notas/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Recusas por motivo",
      "description": "Recusas por type de erro (docs/api/erros.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (type) (rate(recusas_total{service_name=\"gerador-nota-fiscal\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Duração por integração (p95)",
      "description": "Tempo de cada sistema acionado: registro, estoque, entrega e financeiro.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, sistema) (rate(integracao_milliseconds_bucket{service_name=\"gerador-nota-fiscal\"}[$__rate_interval])))",
          "legendFormat": "{{sistema}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tarefas por resultado",
      "description": "Tarefas processadas por sistema e resultado: concluída, nova tentativa, falhou, repetida.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (sistema, resultado) (rate(tarefas_total{service_name=\"gerador-nota-fiscal\"}[$__rate_interval]))",
          "legendFormat": "{{sistema}} {{resultado}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tarefas pendentes",
      "description": "Tarefas abertas por sistema.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (sistema) (tarefas_pendentes{service_name=\"gerador-nota-fiscal\"})",
          "legendFormat": "{{sistema}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tarefa pendente mais antiga",
      "description": "Idade da tarefa aberta mais antiga; o alerta dispara acima de 15 minutos.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (sistema) (tarefas_pendente_mais_antiga_seconds{service_name=\"gerador-nota-fiscal\"})",
          "legendFormat": "{{sistema}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Mensagens na DLQ",
      "description": "Tarefas que falharam 5 vezes, por sistema; reprocessar pelo runbook.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (sistema) (fila_dlq_mensagens{service_name=\"gerador-nota-fiscal\"})",
          "legendFormat": "{{sistema}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conclusão em até 5 minutos",
      "description": "Parte das tarefas concluídas em até 5 minutos após a emissão (SLO de 99%).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(tarefas_conclusao_milliseconds_bucket{service_name=\"gerador-nota-fiscal\",le=\"300000\"}[1h])) / sum(rate(tarefas_conclusao_milliseconds_count{service_name=\"gerador-nota-fiscal\"}[1h]))",
          "legendFormat": "conclusão"
        }
      ]
    }
  ]
}
