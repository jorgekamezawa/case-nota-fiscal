{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "slo-gerador-nota-fiscal",
      "folder": "Gerador de nota fiscal",
      "interval": "1m",
      "rules": [
        {
          "uid": "slo-disponibilidade-rapida",
          "title": "Disponibilidade 99,9%: consumo rápido do orçamento",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "annotations": {
            "summary": "Disponibilidade 99,9% consumindo o orçamento de erro 14.4x acima do sustentável (janelas 1h e 5m).",
            "descricao": "Burn rate no modelo do SRE Workbook (RFC 6.4). Conta só 5xx sobre requisições válidas; 4xx não contam."
          },
          "labels": {
            "servico": "gerador-nota-fiscal",
            "slo": "disponibilidade"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 21600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "((sum(rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\",status=~\"5..\"}[1h])) / sum(rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\",status!~\"4..\"}[1h]))) > 0.0144) and ((sum(rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_milliseconds_count{service_name=\"gerador-nota-fiscal\",uri=\"/api/pedido/gerarNotaFiscal\",status!~\"4..\"}[5m]))) > 0.0144)",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
